from pygame import *
import random
font.init()
font1 = font.Font(None, 35)

window = display.set_mode((700, 500))
display.set_caption('Shooter Game')
background = transform.scale(image.load('Background.png'),(700, 500))

class Game_Spr(sprite.Sprite):
    def __init__(self, player_sprite, player_speed, player_x, player_y, size_x, size_y):
        super().__init__()
        self.image = transform.scale(image.load(player_sprite), (size_x, size_y))
        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y

    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(Game_Spr):
    def update(self):
        keys = key.get_pressed()
        if keys[K_w] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[K_s] and self.rect.y < 350:
            self.rect.y += self.speed

class Player1(Game_Spr):
    def update(self):
        keys = key.get_pressed()
        if keys[K_UP] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[K_DOWN] and self.rect.y < 350:
            self.rect.y += self.speed


hero1 = Player('Platform1.png', 5, 25, 200, 25, 125)
hero2 = Player1('Platform2.png', 5, 650, 200, 25, 125)
ball = Player('Ball.png', 5, 300, 200, 50, 50)

Win1 = font1.render('Player1 win!', True, (0, 0, 0))
Win2 = font1.render('Player2 win!', True, (0, 0, 0))

speed_x = random.choice([-3, 3])
speed_y = random.choice([-3, 3])
Finish = False
run = True
clock = time.Clock()
FPS = 60
score1 = 0
score2 = 0
max_score = 3
match_over = False

while run:
    for e in event.get():
        if e.type == QUIT:
            run = False
    
    if not Finish and not match_over:
    
        if Finish != True:
            ball.rect.x += speed_x
            ball.rect.y += speed_y
        
        if ball.rect.y > 450 or ball.rect.y < 0:
            speed_y *= -1
        
        if sprite.collide_rect(hero1, ball) or sprite.collide_rect(hero2, ball):
            speed_x *= -1.06

        if ball.rect.x <= -55:
            score2 += 1
            Finish = True

        if ball.rect.x >= 750:
            score1 += 1
            Finish = True

        if score1 == max_score or score2 == max_score:
            match_over = True

        window.blit(background,(0, 0))
        hero1.update()
        hero1.reset()
        hero2.update()
        hero2.reset()
        ball.reset()
        score_text = font1.render(str(score1) + ' : ' + str(score2), True, (0, 0, 0))
        window.blit(score_text, (320, 20))

    elif Finish and not match_over:
        window.blit(background,(0, 0))
        ball.rect.x = 300
        ball.rect.y = 200
        hero1.rect.y = 200
        hero2.rect.y = 200
        hero1.reset()
        hero2.reset()
        ball.reset()
        display.update()
        time.wait(2000)
        Finish = False  
        speed_x = random.choice([-3, 3])
        speed_y = random.choice([-3, 3])

    if match_over and score1 == max_score:
        window.blit(Win1, (285, 230))

    if match_over and score2 == max_score:
        window.blit(Win2, (285, 230))

    display.update()
    clock.tick(FPS)
